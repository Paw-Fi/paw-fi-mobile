# Uncomment this line to define a global platform for your project
# Firebase requires iOS 15.0+ as of version 12.0+
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Add permission_handler configuration
def permission_handler_permissions
  ['Camera', 'PhotoLibrary']
end

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'MonekoShareExtension' do
    inherit! :search_paths
  end
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # iOS 26 compatibility: Set minimum deployment target
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # iOS 26 fix: Disable bitcode (deprecated in Xcode 14+)
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end

  # Propagate Flutter version info to the share extension so its generated
  # Info.plist receives valid CFBundleVersion / CFBundleShortVersionString values.
  # The extension's base config is the Pods xcconfig, which does not include
  # Flutter/Generated.xcconfig, so $(FLUTTER_BUILD_NUMBER) resolves to empty.
  flutter_build_name = '1.0.0'
  flutter_build_number = '1'
  generated_xcconfig = File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
  if File.exist?(generated_xcconfig)
    File.foreach(generated_xcconfig) do |line|
      name_match = line.match(/FLUTTER_BUILD_NAME\=(.*)/)
      number_match = line.match(/FLUTTER_BUILD_NUMBER\=(.*)/)
      flutter_build_name = name_match[1].strip if name_match
      flutter_build_number = number_match[1].strip if number_match
    end
  end

  # Open the user project directly and persist the share extension settings.
  runner_project = Xcodeproj::Project.open(File.expand_path('Runner.xcodeproj', __dir__))
  share_extension_target = runner_project.targets.find { |t| t.name == 'MonekoShareExtension' }
  if share_extension_target
    share_extension_target.build_configurations.each do |config|
      config.build_settings['FLUTTER_BUILD_NAME'] = flutter_build_name
      config.build_settings['FLUTTER_BUILD_NUMBER'] = flutter_build_number
      config.build_settings['CURRENT_PROJECT_VERSION'] = flutter_build_number
      config.build_settings['MARKETING_VERSION'] = flutter_build_name
    end
    runner_project.save
  end
end
